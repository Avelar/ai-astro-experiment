---
const { posts, title, intro } = Astro.props;
---
<section class="blog-section section-shell" id="artigos"><div class="blog-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span>04 — Caderno</p><h2>{title}</h2></div><p>{intro}</p></div><div class="post-grid">{posts.map((post) => <article class="post-card"><a class="post-image-link" href={`/blog/${post.slug}/`} aria-label={`Ler ${post.title}`}><img class="post-image" src={post.coverImage} alt={post.coverAlt} loading="lazy" /><span class="post-open" aria-hidden="true">↗</span></a><div class="post-meta"><span>{post.category}</span><time datetime={post.date.toISOString()}>{post.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}</time></div><h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3><p>{post.excerpt}</p><a class="text-link" href={`/blog/${post.slug}/`}>Continuar leitura <span aria-hidden="true">→</span></a></article>)}</div></section>
